prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: High-performance, header-only C++20 decimal arithmetic library
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lfastdecimal
